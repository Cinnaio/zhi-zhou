# 知舟 (zhi-zhou) 环境变量示例
#
# 复制为 .env 后按需修改：cp .env.example .env
# api/src/config.ts 启动时会自动读取项目根目录的 .env。
# 优先级：真实环境变量 > .env > data/runtime-config.json（/install 向导写入）。
#
# 也可以完全不建 .env：留空 DATABASE_URL 启动后访问网页 /install，
# 向导会引导完成数据库连接、可选配置与首个管理员创建，
# 配置持久化到 data/runtime-config.json（已 gitignore，重启仍生效）。

# --- 基础 ---------------------------------------------------------
# API 监听端口
PORT=8787

# --- 备份与恢复 ---------------------------------------------------
# 自动备份默认关闭，进入后台「备份与恢复」配置。首版支持本地 + SFTP。
# 备份主密钥：32 字节随机数据的 Base64，单独保管；不要提交到 Git。
# 生成：node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# BACKUP_ENCRYPTION_KEY=
# BACKUP_KEY_ID=default
# 默认 data/backups；必须位于网站静态目录之外，多 API 实例须使用同一共享目录。
# BACKUP_ROOT=/srv/zhi-zhou-backups
# 可连接的 SFTP 主机名/IP，逗号分隔；也可在后台「备份设置」选择后台配置。
# 选择后台配置时使用数据库内允许列表；回环和链路本地地址始终禁止。
# BACKUP_ALLOWED_HOSTS=backup.example.com
# 需预先创建并标记的专用隔离演练库，数据库名必须不同于业务库。
# 连接地址也可在后台「备份设置」加密保存，页面可选择部署配置/后台配置/关闭。
# 初始化方式见 docs/backup-and-restore-implementation-2026-10-08.md。
# BACKUP_REHEARSAL_DATABASE_URL=postgresql://user:password@localhost:5432/zhi_zhou_rehearsal
# PostgreSQL 工具须与服务器大版本匹配；可按需指定绝对路径。
# BACKUP_PG_DUMP_PATH=pg_dump
# BACKUP_PG_RESTORE_PATH=pg_restore
# BACKUP_PSQL_PATH=psql
# BACKUP_RCLONE_PATH=rclone

# --- R18 人机验证 -------------------------------------------------
# 在 Cloudflare Turnstile 创建 Managed 类型组件并绑定实际前端域名。
# 可通过后台「平台运营 → 站点设置 → 安全验证」配置，或用下列环境变量覆盖。
# 环境变量逐字段优先，后台显示来源并锁定对应字段。Secret 不提交到 Git。
# 缺少任一项时拒绝开启 R18；不影响非 R18 阅读或管理员审核。
# TURNSTILE_SITE_KEY=your-public-site-key
# TURNSTILE_SECRET_KEY=your-secret-key
# 逗号分隔 hostname（无协议/端口）；缺省从 SITE_URL / CORS_ORIGINS 推导。
# TURNSTILE_HOSTNAMES=read.example.com
# 后台保存 Secret 的加密主密钥：32 字节随机数据的 Base64（不是 Turnstile Secret）。
# 生成：node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# 只在部署密钥管理中设置；与数据库一同备份，丢失/更换后旧 Secret 无法解密。
# 未设置时仍可使用环境变量 Secret，但不能从后台保存 Secret。
# SITE_SETTINGS_ENCRYPTION_KEY=
# 正文每账号每分钟上限，可信 IP 上限为其两倍。默认 120，正整数。
# CHAPTER_READ_LIMIT_PER_MINUTE=120

# SEO 正式站点地址（只填 origin，无路径/参数）。缺省时所有 HTML 保持 noindex。
# SITE_URL=https://read.example.com
# 前端构建产物目录；默认项目根目录下 web/dist。
# WEB_DIST_DIR=/app/web/dist

# PostgreSQL 连接串。未配置时 API 进入 needsSetup 模式：
# 除 /api/health 与 /api/setup/*（安装向导）外的请求均返回 503。
DATABASE_URL=postgres://user:pass@localhost:5432/zhi_zhou

# --- CORS ---------------------------------------------------------
# 前端与 API 不同域时必须设置，多个来源用英文逗号分隔。
# CORS_ORIGINS=https://zhi-zhou.example.com

# --- 反向代理 -----------------------------------------------------
# 部署在 Nginx/Caddy/Cloudflare 等反代之后时设为 1，
# 使 IP 限流与登录审计读取转发头（CF-Connecting-IP / X-Forwarded-For / X-Real-IP）。
# 未部署反代时请保持关闭：这些头可被请求方任意伪造。
# TRUST_PROXY=1

# --- 出站请求与代理 -----------------------------------------------
# SSRF 防护默认阻止用户可控 URL 指向环回/内网/链路本地地址。
# 确需抓取内网源（如本地镜像站）时设为 1 跳过检查。
# ALLOW_PRIVATE_FETCH=1

# 标准 HTTP Forward Proxy，作用于 AI、图像、下载、抓取等全部服务端出站请求。
# 前提：代理（Clash/Mihomo）需开启「允许局域网连接」(allow-lan)，否则只监听
# 127.0.0.1，容器无法访问。
# - Docker Desktop（Windows/macOS）：容器用 host.docker.internal 访问宿主机，如下例。
# - Linux Docker：默认 bridge 网关一般是 172.18.0.1（以 docker network inspect
#   bridge 为准；compose 自定义网络网关不同），把下面地址换成 http://172.18.0.1:7890。
# - Windows 原生开发：管理后台填写 http://127.0.0.1:7890，无需写入环境变量。
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890
# NO_PROXY=localhost,127.0.0.1,::1,postgres,redis

# --- 哈希盐 -------------------------------------------------------
# 会话 token 哈希盐 / 评论段评 IP 哈希盐。
# 留空即可：首次启动自动生成随机盐并持久化到 data/runtime-config.json。
# 显式设置后以此处为准（更换会使所有登录会话失效）。
# SESSION_HASH_SALT=
# THOUGHT_HASH_SALT=

# --- AI 文本模型（deepseek-v4-flash，OpenAI 兼容）----------------
AI_TEXT_BASE_URL=https://api.deepseek.com/v1
AI_TEXT_API_KEY=
AI_TEXT_MODEL=deepseek-v4-flash

# --- AI 图像模型（mimo-v2.5，预留，本期不接入）--------------------
# deepseek-v4-flash 不支持图片输入，涉及图像的调用走 mimo-v2.5。
AI_IMAGE_BASE_URL=
AI_IMAGE_API_KEY=
AI_IMAGE_MODEL=mimo-v2.5
