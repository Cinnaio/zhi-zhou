# 知舟 (zhi-zhou) 环境变量示例
#
# 复制为 .env 后按需修改：cp .env.example .env
# api/src/config.ts 启动时会自动读取项目根目录的 .env。
# 优先级：真实环境变量 > .env > data/runtime-config.json（/install 向导写入）。
#
# 也可以完全不建 .env：留空 DATABASE_URL 启动后访问网页 /install，
# 向导会引导完成数据库连接、可选配置与首个管理员创建，
# 配置持久化到 data/runtime-config.json（已 gitignore，重启仍生效）。

# --- 基础 ---------------------------------------------------------
# API 监听端口
PORT=8787

# PostgreSQL 连接串。未配置时 API 进入 needsSetup 模式：
# 除 /api/health 与 /api/setup/*（安装向导）外的请求均返回 503。
DATABASE_URL=postgres://user:pass@localhost:5432/zhi_zhou

# --- CORS ---------------------------------------------------------
# 前端与 API 不同域时必须设置，多个来源用英文逗号分隔。
# CORS_ORIGINS=https://zhi-zhou.example.com

# --- 反向代理 -----------------------------------------------------
# 部署在 Nginx/Caddy/Cloudflare 等反代之后时设为 1，
# 使 IP 限流与登录审计读取转发头（CF-Connecting-IP / X-Forwarded-For / X-Real-IP）。
# 未部署反代时请保持关闭：这些头可被请求方任意伪造。
# TRUST_PROXY=1

# --- 出站请求与代理 -----------------------------------------------
# SSRF 防护默认阻止用户可控 URL 指向环回/内网/链路本地地址。
# 确需抓取内网源（如本地镜像站）时设为 1 跳过检查。
# ALLOW_PRIVATE_FETCH=1

# 标准 HTTP Forward Proxy，作用于 AI、图像、下载、抓取等全部服务端出站请求。
# Docker 可填写宿主机网桥地址（例如 http://172.18.0.1:7890），或配合
# host-gateway 使用 http://host.docker.internal:7890。Windows 原生开发可在
# 后台填写 http://127.0.0.1:7890，无需写入环境变量。
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890
# NO_PROXY=localhost,127.0.0.1,::1,postgres,redis

# --- 哈希盐 -------------------------------------------------------
# 会话 token 哈希盐 / 评论段评 IP 哈希盐。
# 留空即可：首次启动自动生成随机盐并持久化到 data/runtime-config.json。
# 显式设置后以此处为准（更换会使所有登录会话失效）。
# SESSION_HASH_SALT=
# THOUGHT_HASH_SALT=

# --- AI 文本模型（deepseek-v4-flash，OpenAI 兼容）----------------
AI_TEXT_BASE_URL=https://api.deepseek.com/v1
AI_TEXT_API_KEY=
AI_TEXT_MODEL=deepseek-v4-flash

# --- AI 图像模型（mimo-v2.5，预留，本期不接入）--------------------
# deepseek-v4-flash 不支持图片输入，涉及图像的调用走 mimo-v2.5。
AI_IMAGE_BASE_URL=
AI_IMAGE_API_KEY=
AI_IMAGE_MODEL=mimo-v2.5
